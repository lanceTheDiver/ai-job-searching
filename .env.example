# 复制为 .env.local，并填入 OmniRoute 控制台生成的 API Key。
OMNIROUTE_API_KEY=

# 可选：覆盖 OmniRoute 地址和模型。
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto

# 可选：原始 PDF 简历的本机保存目录，默认使用项目下的 .data/resumes。
RESUME_STORAGE_DIR=

# 可选：投递记录与 LinkedIn 专用浏览器配置。
APPLICATION_STORAGE_DIR=
LINKEDIN_BROWSER_DATA_DIR=
LINKEDIN_BROWSER_CHANNEL=chrome

# 可选：岗位搜索历史的本机保存目录，默认使用项目下的 .data/search-history。
SEARCH_HISTORY_STORAGE_DIR=
