# LLM 提供方：omniroute（默认）或 claude（使用本机 Claude Code 订阅登录，无需 API Key）。
LLM_PROVIDER=omniroute
# 可选：LLM_PROVIDER=claude 时指定模型，如 sonnet、opus。
CLAUDE_MODEL=

# LLM_PROVIDER=omniroute 时：填入 OmniRoute 控制台生成的 API Key。
OMNIROUTE_API_KEY=

# 可选：覆盖 OmniRoute 地址和模型。
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto

# 可选：原始 PDF 简历的本机保存目录，默认使用项目下的 .data/resumes。
RESUME_STORAGE_DIR=

# 可选：投递记录目录；辅助投递通过 opencli（Browser Bridge 扩展）控制当前 Chrome，OPENCLI_BIN 可覆盖命令路径。
APPLICATION_STORAGE_DIR=
OPENCLI_BIN=

# 可选：岗位搜索历史的本机保存目录，默认使用项目下的 .data/search-history。
SEARCH_HISTORY_STORAGE_DIR=
